    <model name="soccer_ball">
      <static>false</static>
      <pose>1.2 0 0.085 0 0 0</pose>
      <link name="ball">
        <inertial>
          <mass>0.08</mass>
          <inertia><ixx>0.00018</ixx><iyy>0.00018</iyy><izz>0.00018</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="ball_collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>9.0</mu><mu2>9.0</mu2></ode></friction>
            <bounce><restitution_coefficient>0.02</restitution_coefficient><threshold>0.05</threshold></bounce>
          </surface>
        </collision>
        <visual name="ball_visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>1.0 0.45 0.05 1</ambient><diffuse>1.0 0.45 0.05 1</diffuse></material>
        </visual>
      </link>
