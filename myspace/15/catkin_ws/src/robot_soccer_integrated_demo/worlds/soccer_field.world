<?xml version="1.0"?>
<sdf version="1.6">
  <world name="soccer_field">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.80 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="safety_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>6.0</mu>
                <mu2>6.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name="soccer_field">
      <static>true</static>
      <link name="field_link">
        <collision name="field_collision">
          <geometry>
            <box>
              <size>9.0 6.0 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>6.0</mu>
                <mu2>6.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="field_visual">
          <geometry>
            <box>
              <size>9.0 6.0 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.45 0.10 1</ambient>
            <diffuse>0.05 0.60 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

