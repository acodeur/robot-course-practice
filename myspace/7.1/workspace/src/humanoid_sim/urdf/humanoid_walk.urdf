<?xml version="1.0"?>
<!--
  ========================================
  6DOF 腿部步态行走 URDF
  ========================================

  坐标系约定：
    X = 前方 (机器人面朝 +X)
    Y = 左侧
    Z = 上方

  关节轴约定：
    hip_yaw:   Z轴 (0, 0, 1) - 腿部左右转向 (Yaw)
    hip_roll:  X轴 (1, 0, 0) - 腿部侧倾 (Roll)
    hip_pitch: Y轴 (0, 1, 0) - 腿部前后摆动 (Pitch)
    knee:      Y轴 (0, 1, 0) - 膝关节弯曲 (Pitch)
    ankle_pitch: Y轴 (0, 1, 0) - 脚踝前后 (Pitch)
    ankle_roll:  X轴 (1, 0, 0) - 脚踝侧倾 (Roll)

  腿部运动链：
    torso -> hip_yaw -> hip_roll -> hip_pitch -> thigh -> knee -> shin
           -> ankle_pitch -> ankle_roll -> foot

  关节映射：
    theta[0] -> hip_yaw       (绕Z轴，腿部左右转向)
    theta[1] -> hip_roll      (绕X轴，腿部侧倾)
    theta[2] -> hip_pitch     (绕Y轴，腿部前后摆动)
    theta[3] -> knee          (绕Y轴，膝关节弯曲)
    theta[4] -> ankle_pitch   (绕Y轴，脚踝前后)
    theta[5] -> ankle_roll    (绕X轴，脚踝侧倾)

  腿部几何参数：
    distHipToKnee   (L0) = 0.093 m  (大腿)
    distKneeToAnkle (L1) = 0.105 m  (小腿)
    distAnkleToGround (L2) = 0.032 m (脚高)
    distFeetLateral       = 0.092 m  (两脚间距, +/-0.046 from center)
    legsLength = L0 + L1 + L2 = 0.230 m

  结构：16 个旋转关节 + 2 个固定手部关节
-->

<robot name="humanoid_walk">

  <!-- ==================== 世界根链接 ==================== -->
  <link name="base_link"/>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso"/>
    <!-- legsLength(0.23) + hip_yaw(0.02) + hip_roll(0.01) + ankle_pitch(0.01) = 0.27 -->
    <origin xyz="0 0 0.27" rpy="0 0 0"/>
  </joint>

  <!-- 基础材质 -->
  <material name="blue">
    <color rgba="0.2 0.2 0.8 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>

  <!-- ==================== 躯干 ==================== -->
  <!-- 小型人形机器人，尺寸 0.08 x 0.10 x 0.12 (X x Y x Z) -->
  <link name="torso">
    <visual>
      <geometry>
        <box size="0.08 0.10 0.12"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.10 0.12"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <!-- ==================== 头部 ==================== -->
  <link name="head">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ==================== 左臂 ==================== -->
  <!-- 机器人面朝 +X，左臂在 +Y 侧 -->
  <link name="left_upper_arm">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="left_upper_arm"/>
    <origin xyz="0 0.09 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1.0"/>
  </joint>

  <link name="left_forearm">
    <visual>
      <geometry>
        <cylinder length="0.07" radius="0.015"/>
      </geometry>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.07" radius="0.015"/>
      </geometry>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="left_elbow" type="revolute">
    <parent link="left_upper_arm"/>
    <child link="left_forearm"/>
    <origin xyz="0 0 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="0" effort="5" velocity="1.0"/>
  </joint>

  <!-- 左手末端执行器 -->
  <link name="left_hand">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="left_wrist_fixed" type="fixed">
    <parent link="left_forearm"/>
    <child link="left_hand"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
  </joint>

  <!-- ==================== 右臂 ==================== -->
  <!-- 机器人面朝 +X，右臂在 -Y 侧 -->
  <link name="right_upper_arm">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="right_upper_arm"/>
    <origin xyz="0 -0.09 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1.0"/>
  </joint>

  <link name="right_forearm">
    <visual>
      <geometry>
        <cylinder length="0.07" radius="0.015"/>
      </geometry>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.07" radius="0.015"/>
      </geometry>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="right_elbow" type="revolute">
    <parent link="right_upper_arm"/>
    <child link="right_forearm"/>
    <origin xyz="0 0 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="0" effort="5" velocity="1.0"/>
  </joint>

  <!-- 右手末端执行器 -->
  <link name="right_hand">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="right_wrist_fixed" type="fixed">
    <parent link="right_forearm"/>
    <child link="right_hand"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================ -->
  <!-- ==================== 左腿（6DOF 参数） ==================== -->
  <!-- ================================================================ -->
  <!--
    运动链：torso -> hip_yaw -> hip_roll -> hip_pitch -> thigh -> knee -> shin
                       -> ankle_pitch -> ankle_roll -> foot

    几何参数：
      hip -> knee  (L0) = 0.093 m
      knee -> ankle(L1) = 0.105 m
      ankle -> ground(L2)= 0.032 m

    关节轴（面朝 +X）：
      hip_yaw:   Z轴 (0, 0, 1)
      hip_roll:  X轴 (1, 0, 0)
      hip_pitch: Y轴 (0, 1, 0)
      knee:      Y轴 (0, 1, 0)
      ankle_pitch: Y轴 (0, 1, 0)
      ankle_roll:  X轴 (1, 0, 0)
  -->

  <!-- 左髋偏航（Yaw）：腿部左右转向，绕Z轴 -->
  <link name="left_hip_yaw_link">
    <visual>
      <geometry><cylinder length="0.02" radius="0.02"/></geometry>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.02" radius="0.02"/></geometry>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_hip_yaw" type="revolute">
    <parent link="torso"/>
    <child link="left_hip_yaw_link"/>
    <!-- 左腿在 +Y 侧，y = +distFeetLateral/2 = +0.046 -->
    <origin xyz="0 0.046 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
  </joint>

  <!-- 左髋侧倾（Roll）：腿部侧向展开，绕X轴 -->
  <link name="left_hip_roll_link">
    <visual>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="left_hip_roll" type="revolute">
    <parent link="left_hip_yaw_link"/>
    <child link="left_hip_roll_link"/>
    <!-- hip_yaw_link 高度 0.02m -->
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
  </joint>

  <!-- 左髋俯仰（Pitch）：腿部前后摆动，绕Y轴 -->
  <!-- 大腿 (thigh)：长度 L0 = 0.093 m -->
  <link name="left_thigh">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.093"/>
      </geometry>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.093"/>
      </geometry>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip_roll_link"/>
    <child link="left_thigh"/>
    <!-- hip_roll_link 高度 0.01m -->
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="20" velocity="2.0"/>
  </joint>

  <!-- 左膝：膝关节弯曲，绕Y轴 -->
  <!-- 小腿 (shin)：长度 L1 = 0.105 m -->
  <link name="left_shin">
    <visual>
      <geometry>
        <box size="0.035 0.035 0.105"/>
      </geometry>
      <origin xyz="0 0 -0.0525" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.035 0.035 0.105"/>
      </geometry>
      <origin xyz="0 0 -0.0525" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.0525" rpy="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <!-- thigh 长度 L0 = 0.093 m -->
    <origin xyz="0 0 -0.093" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.5" effort="20" velocity="2.0"/>
  </joint>

  <!-- 左踝俯仰（Pitch）：脚踝前后，绕Y轴 -->
  <link name="left_ankle_pitch_link">
    <visual>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="left_ankle_pitch" type="revolute">
    <parent link="left_shin"/>
    <child link="left_ankle_pitch_link"/>
    <!-- shin 长度 L1 = 0.105 m -->
    <origin xyz="0 0 -0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="10" velocity="1.0"/>
  </joint>

  <!-- 左踝侧倾（Roll）：脚踝侧倾，绕X轴 -->
  <!-- 脚 (foot)：高度 L2 = 0.032 m -->
  <link name="left_foot">
    <visual>
      <geometry>
        <box size="0.12 0.06 0.032"/>
      </geometry>
      <origin xyz="0.02 0 -0.016" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.12 0.06 0.032"/>
      </geometry>
      <origin xyz="0.02 0 -0.016" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.20"/>
      <origin xyz="0.02 0 -0.016" rpy="0 0 0"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0026" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="left_ankle_roll" type="revolute">
    <parent link="left_ankle_pitch_link"/>
    <child link="left_foot"/>
    <!-- ankle_pitch_link 高度 0.01m -->
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
  </joint>

  <!-- ================================================================ -->
  <!-- ==================== 右腿（6DOF，左腿镜像） ==================== -->
  <!-- ================================================================ -->

  <!-- 右髋偏航（Yaw）：腿部左右转向，绕Z轴 -->
  <link name="right_hip_yaw_link">
    <visual>
      <geometry><cylinder length="0.02" radius="0.02"/></geometry>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.02" radius="0.02"/></geometry>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_hip_yaw" type="revolute">
    <parent link="torso"/>
    <child link="right_hip_yaw_link"/>
    <!-- 右腿在 -Y 侧，y = -distFeetLateral/2 = -0.046 -->
    <origin xyz="0 -0.046 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
  </joint>

  <!-- 右髋侧倾（Roll）：腿部侧向展开，绕X轴 -->
  <link name="right_hip_roll_link">
    <visual>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="right_hip_roll" type="revolute">
    <parent link="right_hip_yaw_link"/>
    <child link="right_hip_roll_link"/>
    <!-- hip_yaw_link 高度 0.02m -->
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
  </joint>

  <!-- 右髋俯仰（Pitch）：腿部前后摆动，绕Y轴 -->
  <!-- 大腿 (thigh)：长度 L0 = 0.093 m -->
  <link name="right_thigh">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.093"/>
      </geometry>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.093"/>
      </geometry>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child link="right_thigh"/>
    <!-- hip_roll_link 高度 0.01m -->
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="20" velocity="2.0"/>
  </joint>

  <!-- 右膝：膝关节弯曲，绕Y轴 -->
  <!-- 小腿 (shin)：长度 L1 = 0.105 m -->
  <link name="right_shin">
    <visual>
      <geometry>
        <box size="0.035 0.035 0.105"/>
      </geometry>
      <origin xyz="0 0 -0.0525" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.035 0.035 0.105"/>
      </geometry>
      <origin xyz="0 0 -0.0525" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.0525" rpy="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <!-- thigh 长度 L0 = 0.093 m -->
    <origin xyz="0 0 -0.093" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.5" effort="20" velocity="2.0"/>
  </joint>

  <!-- 右踝俯仰（Pitch）：脚踝前后，绕Y轴 -->
  <link name="right_ankle_pitch_link">
    <visual>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.01" radius="0.015"/></geometry>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="right_ankle_pitch" type="revolute">
    <parent link="right_shin"/>
    <child link="right_ankle_pitch_link"/>
    <!-- shin 长度 L1 = 0.105 m -->
    <origin xyz="0 0 -0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="10" velocity="1.0"/>
  </joint>

  <!-- 右踝侧倾（Roll）：脚踝侧倾，绕X轴 -->
  <!-- 脚 (foot)：高度 L2 = 0.032 m -->
  <link name="right_foot">
    <visual>
      <geometry>
        <box size="0.12 0.06 0.032"/>
      </geometry>
      <origin xyz="0.02 0 -0.016" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.12 0.06 0.032"/>
      </geometry>
      <origin xyz="0.02 0 -0.016" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.20"/>
      <origin xyz="0.02 0 -0.016" rpy="0 0 0"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0026" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="right_ankle_roll" type="revolute">
    <parent link="right_ankle_pitch_link"/>
    <child link="right_foot"/>
    <!-- ankle_pitch_link 高度 0.01m -->
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
  </joint>

  <!-- ================================================================ -->
  <!-- ==================== Transmissions ============================= -->
  <!-- ================================================================ -->

  <!-- 左臂传动 -->
  <transmission name="left_shoulder_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_shoulder_pitch">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_shoulder_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_elbow_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_elbow">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_elbow_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- 右臂传动 -->
  <transmission name="right_shoulder_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_shoulder_pitch">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_shoulder_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_elbow_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_elbow">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_elbow_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- 左腿传动（6DOF） -->
  <transmission name="left_hip_yaw_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_yaw">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_yaw_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_hip_roll_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_roll">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_roll_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_hip_pitch_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_pitch">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_pitch_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_knee_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_knee">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_knee_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_ankle_pitch_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_ankle_pitch">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_ankle_pitch_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_ankle_roll_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_ankle_roll">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_ankle_roll_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- 右腿传动（6DOF） -->
  <transmission name="right_hip_yaw_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_hip_yaw">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_hip_yaw_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_hip_roll_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_hip_roll">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_hip_roll_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_hip_pitch_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_hip_pitch">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_hip_pitch_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_knee_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_knee">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_knee_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_ankle_pitch_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_ankle_pitch">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_ankle_pitch_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_ankle_roll_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_ankle_roll">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_ankle_roll_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ================================================================ -->
  <!-- ==================== Gazebo 扩展 =============================== -->
  <!-- ================================================================ -->

  <gazebo reference="torso">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_thigh">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="right_thigh">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- 脚部接触属性：mu1=1.0, mu2=1.0 对行走稳定性至关重要 -->
  <!-- minDepth=0.001 防止脚底穿地, kp/kd 硬接触+阻尼减少振荡 -->
  <gazebo reference="left_foot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <minDepth>0.001</minDepth>
    <kp>1000000</kp>
    <kd>100</kd>
  </gazebo>

  <gazebo reference="right_foot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <minDepth>0.001</minDepth>
    <kp>1000000</kp>
    <kd>100</kd>
  </gazebo>

  <!-- ros_control Gazebo 插件 -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/humanoid</robotNamespace>
      <robotParam>robot_description</robotParam>
      <controlPeriod>0.001</controlPeriod>
    </plugin>
  </gazebo>

</robot>
