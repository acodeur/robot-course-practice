          <mxGeometry height="90" width="336" x="640" y="157" as="geometry" />
        </mxCell>
        <mxCell id="8on4iygDfZKdJ-fiH2K1-33" parent="1" style="shape=note;backgroundOutline=1;darkOpacity=0.05;fontColor=default;whiteSpace=wrap;html=1;shadow=1;gradientColor=none;align=left;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;stepSpline: 前后移动轨迹(X)&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;swingSpline: 躯干横向摆动轨迹(Y)&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;riseSpline: 抬脚高度轨迹(Z)&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;turnSpline: 足部转向轨迹(Yaw)&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="90" width="280" x="640" y="261" as="geometry" />
        </mxCell>
        <mxCell id="8on4iygDfZKdJ-fiH2K1-34" parent="1" style="shape=note;backgroundOutline=1;darkOpacity=0.05;fontColor=default;whiteSpace=wrap;html=1;shadow=1;gradientColor=none;align=left;" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;leftX = params.enabledGain * params.stepGain * stepSpline.pos(phaseLeft)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;leftY += params.enabledGain * params.lateralGain * (stepSpline.pos(phaseLeft) + 0.5 * (1.0 if params.lateralGain &amp;gt;= 0.0 else -1.0))&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;leftZ = params.enabledGain * params.riseGain * riseSpline.pos(phaseLeft)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;leftYaw = params.enabledGain * params.turnGain * turnSpline.pos(phaseLeft)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;leftPitch = params.trunkPitch&lt;br&gt;&lt;/span&gt;leftRoll = params.trunkparams.enabledGain * -params.swingRollGain * swingSpline.posMod(0.5 + phaseLeft + params.swingPhase) + params.trunkRoll&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="90" width="858" x="640" y="368" as="geometry" />
        </mxCell>
        <mxCell id="8on4iygDfZKdJ-fiH2K1-35" parent="1" style="shape=note;backgroundOutline=1;darkOpacity=0.05;fontColor=default;whiteSpace=wrap;html=1;shadow=1;gradientColor=none;align=left;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;旋转矩阵: rotation = pitchRot @ rollRot&lt;br&gt;坐标变换: posLeft = rotation @ np.array([leftX, leftY, leftZ])&lt;br&gt;偏移修正: posLeft[i] -= params.trunkOffset&lt;br&gt;旋转补偿: posLeft[0] += model.legsLength()...&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="90" width="398" x="640" y="471" as="geometry" />
        </mxCell>
        <mxCell id="8on4iygDfZKdJ-fiH2K1-36" parent="1" style="shape=note;backgroundOutline=1;darkOpacity=0.05;fontColor=default;whiteSpace=wrap;html=1;shadow=1;gradientColor=none;align=left;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;successLeft = model.legIkLeft()...内部计算6个关节角&lt;br&gt;&lt;/span&gt;successRight = model.legIkRight()...内部计算6个关节角&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;_setIKResult()&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="90" width="401" x="640" y="574" as="geometry" />
        </mxCell>
