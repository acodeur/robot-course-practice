<?xml version="1.0"?>
<robot name="arm_5dof">
  <!-- 5自由度串联机械臂：SolidWorks建模 -> STL + URDF，模型为Z-up，单位米；各link坐标系原点位于其父关节轴心 -->
  <material name="dark_gray"><color rgba="0.35 0.37 0.40 1"/></material>
  <material name="blue"><color rgba="0.13 0.35 0.75 1"/></material>
  <material name="orange"><color rgba="0.90 0.47 0.10 1"/></material>
  <material name="cyan"><color rgba="0.16 0.63 0.72 1"/></material>
  <material name="red"><color rgba="0.76 0.18 0.15 1"/></material>
  <material name="green"><color rgba="0.15 0.65 0.32 1"/></material>
  <link name="base_link">
    <inertial>
      <origin xyz="-9.85494e-11 5.05041e-18 -0.0220966"/>
      <mass value="10.4022"/>
      <inertia ixx="0.0400497" ixy="-8.31151e-19" ixz="-3.68057e-11" iyy="0.0400497" iyz="-1.23877e-18" izz="0.0745209"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_5dof/meshes/base_link.STL"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_5dof/meshes/base_link.STL"/></geometry>
    </collision>
  </link>
  <link name="link_1">
    <inertial>
      <origin xyz="7.80882e-07 -5.97251e-19 0.0369475"/>
      <mass value="3.29071"/>
      <inertia ixx="0.00916295" ixy="6.13349e-09" ixz="3.32707e-08" iyy="0.00946072" iyz="-5.0701e-19" izz="0.0083269"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://arm_5dof/meshes/link_1.STL"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://arm_5dof/meshes/link_1.STL"/></geometry>
    </collision>
  </link>
  <link name="link_2">
    <inertial>
      <origin xyz="3.20649e-08 -2.52268e-08 0.148047"/>
      <mass value="6.22282"/>
      <inertia ixx="0.09586" ixy="-1.24125e-08" ixz="-7.61272e-08" iyy="0.0929149" iyz="5.99354e-08" izz="0.0101465"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://arm_5dof/meshes/link_2.STL"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://arm_5dof/meshes/link_2.STL"/></geometry>
    </collision>
  </link>
  <link name="link_3">
    <inertial>
      <origin xyz="8.86955e-11 8.17399e-10 0.122471"/>
      <mass value="4.6642"/>
      <inertia ixx="0.052194" ixy="-1.18982e-07" ixz="-1.44944e-10" iyy="0.0498209" iyz="-4.68759e-10" izz="0.00640528"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://arm_5dof/meshes/link_3.STL"/></geometry>
      <material name="cyan"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://arm_5dof/meshes/link_3.STL"/></geometry>
    </collision>
  </link>
  <link name="link_4">
    <inertial>
      <origin xyz="-2.36202e-07 4.52762e-08 -0.0963569"/>
      <mass value="1.3415"/>
      <inertia ixx="0.00450255" ixy="1.84468e-08" ixz="-3.19489e-08" iyy="0.00273866" iyz="5.00714e-09" izz="0.00249165"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://arm_5dof/meshes/link_4.STL"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://arm_5dof/meshes/link_4.STL"/></geometry>
    </collision>
  </link>
  <link name="link_5">
    <inertial>
      <origin xyz="1.66848e-11 9.42565e-19 0.0199533"/>
      <mass value="0.45494"/>
      <inertia ixx="0.000400657" ixy="-1.12106e-21" ixz="2.57726e-13" iyy="0.000361425" iyz="1.51255e-20" izz="0.000333876"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://arm_5dof/meshes/link_5.STL"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://arm_5dof/meshes/link_5.STL"/></geometry>
    </collision>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="30" velocity="1.5"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="1.5"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <joint name="elbow_pitch" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="20" velocity="1.5"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <joint name="wrist_pitch" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.37" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="10" velocity="2.0"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="8" velocity="2.5"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
</robot>
